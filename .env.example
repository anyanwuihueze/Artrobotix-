# Local PostgreSQL Connection (Required for local development & drizzle-kit)
SQL_HOST="localhost"
SQL_DB_NAME="artdrobotix"
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_postgres_password"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional unless using Gemini AI endpoints.
GEMINI_API_KEY=""

# PAYSTACK (Optional — configure test/live keys for automated payment initiation and webhook reconciliation)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# RESEND (Optional — configure live key for transactional email delivery)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="admissions@artdrobotix.edu.ng"
